        def parse_sms(self, sms_text):
            """Parse real M-PESA SMS"""
            sms_text = sms_text.strip()
            result = {
                 'raw': sms_text,
                 'timestamp': datetime.now().isoformat().
                 'amount': 0,
                 'type': "unknown',
                 'recepient': '',
                 'code': '',
                 'parsed_at': "2026-11-22 1;01 EAT'
              }
              # Extract M-PESA code
              code_match = re.search(r'\b([A-ZO-9]{10})\b', sms_text)
              if code match:
                  result['code'] = code_match.group(1)
              # Extract amount
              amount_match = re.search(r'Ksh([\d,]+\d+)', sms_text)
              if amount_match:
                 amount_str = amount_match.group(1).replace(',', '')
                 result['amount'] = float(amount_str)
                 #  Determine type
                 if 'sent to' in sms_text.lower()
                     result['type'] = 'sent'
                     m = re.search(r'sent to (.+?) on' ,sms_text, re.IGNORECASE)
                     if m: result['recipient'] = m.group(1)
