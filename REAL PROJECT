from datetime import datetime
import json
import re


class MpesaParser:
    """Parse M-PESA transaction SMS messages."""

    def __init__(self):
        self.parsed = []

    def parse_sms(self, sms_text):
        """Parse one M-PESA SMS and append the transaction to the history."""
        if not isinstance(sms_text, str):
            raise TypeError("sms_text must be a string")

        sms_text = sms_text.strip()
        result = {
            "raw": sms_text,
            "timestamp": datetime.now().isoformat(),
            "amount": 0.0,
            "type": "unknown",
            "recipient": "",
            "code": "",
        }

        if not sms_text:
            return result

        code_match = re.search(r"\b[A-Z0-9]{10}\b", sms_text)
        if code_match:
            result["code"] = code_match.group(0)

        amount_match = re.search(r"Ksh([\d,]+(?:\.\d+)?)", sms_text, re.IGNORECASE)
        if amount_match:
            result["amount"] = float(amount_match.group(1).replace(",", ""))

        lower_text = sms_text.lower()

        if "sent to" in lower_text:
            result["type"] = "sent"
            match = re.search(r"sent to\s+(.+?)\s+on\b", sms_text, re.IGNORECASE)
            if match:
                result["recipient"] = match.group(1).strip()
        elif "received" in lower_text:
            result["type"] = "received"
            match = re.search(r"(?:received\s+Ksh[\d,]+(?:\.\d+)?\s+from\s+)(.+?)(?:\s+on\b|\.\s|$)", sms_text, re.IGNORECASE)
            if match:
                result["recipient"] = match.group(1).strip()
        elif "paid to" in lower_text:
            result["type"] = "buy"
            match = re.search(r"paid to\s+(.+?)\s+on\b", sms_text, re.IGNORECASE)
            if match:
                result["recipient"] = match.group(1).strip()
        elif "withdrawn" in lower_text:
            result["type"] = "withdraw"

        self.parsed.append(result)
        return result

    def parse_batch(self, sms_list):
        """Parse a batch of SMS strings."""
        if sms_list is None:
            raise TypeError("sms_list cannot be None")
        return [self.parse_sms(sms) for sms in sms_list]

    def get_total_spent(self):
        """Return the total amount spent on sent and purchase transactions."""
        return sum(
            transaction["amount"]
            for transaction in self.parsed
            if transaction["type"] in {"sent", "buy", "withdraw"}
        )

    def export_json(self, filename="loggy3_data_nov22.json"):
        """Export parsed transactions to a JSON file."""
        with open(filename, "w", encoding="utf-8") as file:
            json.dump(self.parsed, file, indent=2, ensure_ascii=False)
        print(f"[EXPORT] saved {len(self.parsed)} transactions to {filename}")


